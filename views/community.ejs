<div class="community-lightbox" id="community-lightbox" hidden aria-hidden="true">
  <div class="community-lightbox-backdrop" data-close></div>
  <div class="community-lightbox-card" role="dialog" aria-modal="true" aria-label="Gallery">
    <div class="community-lightbox-head">
      <span class="community-lightbox-counter" id="lb-counter">1 / 1</span>
      <button class="community-lightbox-close" id="lb-close" aria-label="Close gallery"><i data-lucide="x"></i></button>
    </div>
    <div class="community-lightbox-stage">
      <button class="community-lightbox-nav prev" id="lb-prev" aria-label="Previous"><i data-lucide="chevron-left"></i></button>
      <div class="community-lightbox-media" id="lb-media"></div>
      <button class="community-lightbox-nav next" id="lb-next" aria-label="Next"><i data-lucide="chevron-right"></i></button>
    </div>
    <p class="community-lightbox-caption" id="lb-caption"></p>
    <div class="community-lightbox-thumbs" id="lb-thumbs"></div>
  </div>
