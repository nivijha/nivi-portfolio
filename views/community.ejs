<% layout('layouts/boilerplate') %>

<section id="community" class="community-section reveal">
  <div class="section-inner">

    <div class="community-header">
      <div class="section-text">
        <h2 class="section-title">Community</h2>
        <p class="section-subtitle">
          Events, sessions, hackathons and team work beyond classrooms — where I learn, build and show up with people.
        </p>
      </div>

      <div class="community-hero-wrap">
        <button class="community-postcard community-postcard--hero" aria-label="Open gallery — featured moments" data-gallery='[{"src":"/images/Cummunity_postcard.jpeg","caption":"Community — featured moment 1.","type":"image"},{"src":"/images/Cummunity_postcard%20(1).png","caption":"Community — featured moment 2.","type":"image"},{"src":"/images/Cummunity_postcard%20(2).png","caption":"Community — featured moment 3.","type":"image"},{"src":"/images/Cummunity_postcard%20(3).png","caption":"Community — featured moment 4.","type":"image"},{"src":"/images/Cummunity_postcard%20(4).png","caption":"Community — featured moment 5.","type":"image"},{"src":"/images/Cummunity_postcard%20(5).png","caption":"Community — featured moment 6.","type":"image"}]'>
          <span class="community-postcard-tape" aria-hidden="true"></span>
          <span class="community-postcard-frame">
            <img src="/images/Cummunity_postcard.jpeg" alt="Featured community photo" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid'">
            <span class="community-postcard-fallback" style="display:none"><em>add photos</em></span>
            <span class="community-postcard-count" aria-hidden="true">1 / 6</span>
          </span>
          <span class="community-postcard-label"><i data-lucide="images"></i> 6 photos — tap to view</span>
        </button>
        <p class="community-hero-caption">// featured moments — tap to browse all</p>
      </div>
    </div>

    <div class="community-filters" role="tablist" aria-label="Community filters">
