            <span class="playlist-name">hooiii🖖🏼</span>
            <span class="playlist-caption">// getting-ready-music.mp3</span>
          </span>
          <span class="playlist-meta">166 songs · let's groove!! 🕺</span>
          <span class="playlist-preview" aria-hidden="true">
            <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/playlist/4B5PuPSkHWXoxh5h5hKtDT?utm_source=generator&si=0d97f08ec8c64db7" width="75%" height="352" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
          </span>
        </a>

        <a class="vinyl-card playlist-card" href="https://open.spotify.com/playlist/4E2DUQK2Q9bgJt9kRpbxVL" target="_blank" rel="noopener">
          <span class="spotify-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="#fff"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42a.62.62 0 0 1-.86.21c-2.35-1.44-5.3-1.76-8.79-.96a.62.62 0 1 1-.28-1.21c3.81-.87 7.08-.5 9.72 1.1a.62.62 0 0 1 .21.86zm1.23-2.74a.78.78 0 0 1-1.07.26c-2.69-1.65-6.79-2.13-9.97-1.17a.78.78 0 1 1-.45-1.49c3.63-1.1 8.15-.56 11.24 1.33a.78.78 0 0 1 .25 1.07zm.1-2.85C14.83 8.96 9.4 8.78 6.3 9.72a.93.93 0 1 1-.54-1.78c3.56-1.08 9.56-.87 13.33 1.36a.93.93 0 0 1-.95 1.60z"/></svg>
          </span>
