<% layout('layouts/boilerplate') %>

  <section id="skills" class="skills-section reveal">
    <div class="section-inner">
      <div class="section-text">
        <h2 class="section-title">Technical Skills</h2>
        <p class="section-subtitle">
          Core technologies I use to build full-stack, cloud-native, and ML-enabled products.
        </p>
      </div>

      <div class="skills-content">

        <!-- Core Stack Summary -->
        <div class="core-stack">
          <span class="core-stack-label"><span class="core-stack-sigil">//</span> core stack</span>
          <div class="core-stack-icons">
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/react.svg" alt="React"></span>
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/nodejs-icon.svg" alt="Node.js"></span>
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/python.svg" alt="Python"></span>
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/mongodb-icon.svg" alt="MongoDB"></span>
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/aws.svg" alt="AWS"></span>
            <span class="core-stack-icon"><img src="https://api.iconify.design/logos/docker-icon.svg" alt="Docker"></span>
          </div>
        </div>

        <!-- Category Cards -->
        <div class="skills-grid">

          <!-- Languages -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> languages</div>
            <div class="skill-pills">
              <span class="skill-pill strong">Java</span>
              <span class="skill-pill strong">Python</span>
              <span class="skill-pill">JavaScript</span>
              <span class="skill-pill">SQL</span>
            </div>
          </div>

          <!-- Core CS -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> core cs</div>
            <div class="skill-pills">
              <span class="skill-pill strong">Data Structures & Algorithms</span>
              <span class="skill-pill">Object-Oriented Programming</span>
              <span class="skill-pill">Operating Systems</span>
              <span class="skill-pill">Database Management Systems</span>
              <span class="skill-pill">Computer Networks</span>
            </div>
          </div>

          <!-- Frontend & Backend -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> frontend & backend</div>
            <div class="skill-pills">
              <span class="skill-pill strong">React.js</span>
              <span class="skill-pill">Next.js</span>
              <span class="skill-pill strong">Node.js</span>
              <span class="skill-pill">Express.js</span>
              <span class="skill-pill">FastAPI</span>
              <span class="skill-pill">REST APIs</span>
            </div>
          </div>

          <!-- Databases -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> databases</div>
            <div class="skill-pills">
              <span class="skill-pill strong">MongoDB</span>
              <span class="skill-pill">MySQL</span>
              <span class="skill-pill">Redis</span>
            </div>
          </div>

          <!-- Systems -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> systems</div>
            <div class="skill-pills">
              <span class="skill-pill strong">Docker</span>
              <span class="skill-pill strong">Linux</span>
              <span class="skill-pill">Git</span>
              <span class="skill-pill">GitHub</span>
            </div>
          </div>

          <!-- Cloud -->
          <div class="skill-card">
            <div class="skill-card-label"><span class="skill-card-sigil">//</span> cloud</div>
            <div class="skill-pills">
              <span class="skill-pill strong">AWS Lambda</span>
              <span class="skill-pill">AWS Comprehend</span>
              <span class="skill-pill">Vercel</span>
              <span class="skill-pill">Render</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>