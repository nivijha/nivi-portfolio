<div id="nivi-chatbot" aria-live="polite">
  <div id="nivi-cb-panel" class="nivi-cb-panel" hidden role="dialog" aria-modal="false" aria-label="Nivi's cat assistant">
    <div class="nivi-cb-head">
      <span class="nivi-cb-head-title"><span class="nivi-cb-ears" aria-hidden="true">ฅ^•ﻌ•^ฅ</span> nivi's cat — ask me-ow</span>
      <span class="nivi-cb-head-actions">
        <button id="nivi-cb-clear" class="nivi-cb-icon-btn" aria-label="Clear chat" title="Clear">↻</button>
        <button id="nivi-cb-close" class="nivi-cb-icon-btn" aria-label="Close chat">×</button>
      </span>
    </div>
    <div id="nivi-cb-body" class="nivi-cb-body" role="log" aria-live="polite"></div>
    <div class="nivi-cb-inputbar">
      <input id="nivi-cb-input" class="nivi-cb-input" type="text" placeholder="Ask about Nivi..." autocomplete="off" aria-label="Ask about Nivi" />
      <button id="nivi-cb-send" class="nivi-cb-send" aria-label="Send">Send</button>
    </div>
  </div>
  <button id="nivi-cb-btn" class="nivi-cb-btn" aria-label="Open portfolio assistant" aria-expanded="false" aria-controls="nivi-cb-panel" hidden>
    <span class="nivi-cb-btn-inner">&gt;_<span class="nivi-cb-dot" aria-hidden="true"></span></span>
  </button>
</div>
