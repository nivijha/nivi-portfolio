                <h3 class="project-card-title">CardioVision</h3>
                <p class="project-card-impact">End-to-end clinical AI pipeline for coronary artery stenosis detection</p>
              </div>
              <button class="project-card-toggle" aria-label="Expand project details" aria-expanded="false">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
